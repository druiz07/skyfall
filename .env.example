# Copy this file to .env and fill in your own values. Never commit .env.
# Without credentials SKYFALL runs in demo mode with synthetic data.

# Data source: auto (Space-Track if credentials below, else demo), demo or spacetrack
SKYFALL_SOURCE=auto

# Space-Track.org account (https://www.space-track.org/auth/createAccount)
SPACETRACK_USER=
SPACETRACK_PASSWORD=

# OpenSky Network API client (https://opensky-network.org/my-opensky/account)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
